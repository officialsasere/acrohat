{
  "name": "kwiiva-paper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "predev": "node scripts/copy-ocr-assets.mjs",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "verify": "yarn typecheck && oxlint && yarn test",
    "build:paper": "tsc -b && cross-env KWIIVA_APP=paper vite build && node scripts/prune-dist.mjs paper",
    "build:write": "tsc -b && cross-env KWIIVA_APP=write vite build && node scripts/prune-dist.mjs write",
    "prebuild:paper": "node scripts/copy-ocr-assets.mjs",
    "build:grid": "tsc -b && cross-env KWIIVA_APP=grid vite build && node scripts/prune-dist.mjs grid",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@embedpdf/pdfium": "^2.15.1",
    "@fontsource/caladea": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "@netlify/blobs": "^11.1.6",
    "@signpdf/placeholder-pdf-lib": "^4.0.0",
    "@signpdf/signer-p12": "^4.0.0",
    "@signpdf/signpdf": "^4.0.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-character-count": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-typography": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "buffer": "^6.0.3",
    "fflate": "^0.8.3",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.3",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/node-forge": "^1.3.14",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "exceljs": "^4.4.0",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.88.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "description": "Free, open-source PDF reader and editor"
}
