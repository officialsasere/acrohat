{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kwiiva Paper",
  "version": "0.1.0",
  "identifier": "io.github.officialsasere.kwiiva-paper",
  "build": {
    "frontendDist": "../dist-paper",
    "devUrl": "http://localhost:5173/paper/app/",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:paper"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kwiiva Paper",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "url": "paper/app/index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost data: blob: https://kwiiva.netlify.app"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Edit, convert and sign PDFs",
    "longDescription": "Free, open-source tool to edit, convert and sign PDF files. Everything runs on your computer.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "mimeType": "application/pdf",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
